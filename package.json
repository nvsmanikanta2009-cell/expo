{
  "name": "ai-accessibility-assistant",
  "version": "1.0.0",
  "description": "AI-Powered Accessibility & Inclusion Assistant",
  "main": "server/index.ts",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "vite build",
    "build:all": "vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx server/tests/run_tests.ts",
    "db:migrate": "node scripts/migrate.js"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@ngrok/ngrok": "^1.7.0",
    "@supabase/supabase-js": "^2.117.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "pg": "^8.13.3",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.29.0",
    "ssh2": "^1.17.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "uuid": "^11.1.0",
    "vite": "^5.4.14",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.11.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.2",
    "localtunnel": "^2.0.2",
    "tsx": "^4.19.3"
  }
}
